# ============================================================
# MediKiosk Spring Service — Environment Variable Template
# Copy to .env, fill in real values, and NEVER commit .env.
# ============================================================

# --- PostgreSQL ---
DB_URL=jdbc:postgresql://localhost:5432/medikiosk
DB_USERNAME=medikiosk
DB_PASSWORD=medikioskPostGre

# --- JWT ---
# Generate a secure random 256-bit secret, e.g.:
#   openssl rand -base64 32
JWT_SECRET=JWT@&SECRET@&MEDIKIOSK156
JWT_ACCESS_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=7

# --- Login security ---
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
RESET_TOKEN_EXPIRY_MINUTES=30

# --- CORS ---
# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Service-to-service (Node BFF → Spring) ---
# Generate with: openssl rand -hex 32
# Production path: replace with mTLS client certificates.
SERVICE_API_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_SERVICE_KEY

# --- Admin bootstrap ---
# Runs ONCE on startup when no ADMIN user exists in the database.
# Set ADMIN_BOOTSTRAP_ENABLED=false after the first successful run,
# or leave enabled — it is a no-op when an ADMIN already exists.
ADMIN_BOOTSTRAP_ENABLED=true
ADMIN_BOOTSTRAP_EMAIL=admin@medikiosk.local
ADMIN_BOOTSTRAP_FULL_NAME=System Administrator
ADMIN_BOOTSTRAP_PASSWORD=Ajay@Medikiosk06
# --- Server ---
SERVER_PORT=8080

# --- Spring profile ---
SPRING_PROFILES_ACTIVE=dev
